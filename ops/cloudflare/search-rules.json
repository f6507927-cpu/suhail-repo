{
  "http_ratelimit": {
    "ref": "suhail_public_search_limit",
    "description": "Public search: shared AR/EN per-IP counter (D-121)",
    "enabled": false,
    "expression": "lower(url_decode(http.request.uri.path, \"r\")) in {\"/search\" \"/search/\" \"/en/search\" \"/en/search/\" \"/ar/search\" \"/ar/search/\"}",
    "action": "block",
    "action_parameters": {
      "response": {
        "status_code": 429,
        "content_type": "text/html",
        "content": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"robots\" content=\"noindex, nofollow\"><title>تجاوزت الحد المسموح من الطلبات، حاول مجددا لاحقا</title></head><body><main><p lang=\"ar\" dir=\"rtl\">تجاوزت الحد المسموح من الطلبات، حاول مجددا لاحقا</p><p lang=\"en\" dir=\"ltr\">You have exceeded the request limit. Please try again later.</p></main></body></html>"
      }
    },
    "ratelimit": {
      "characteristics": ["cf.colo.id", "ip.src"],
      "period": 60,
      "requests_per_period": 30,
      "mitigation_timeout": 60
    }
  },
  "http_request_cache_settings": {
    "ref": "suhail_public_search_no_cache",
    "description": "Never cache query-driven public search or its edge errors",
    "enabled": false,
    "expression": "lower(url_decode(http.request.uri.path, \"r\")) in {\"/search\" \"/search/\" \"/en/search\" \"/en/search/\" \"/ar/search\" \"/ar/search/\"}",
    "action": "set_cache_settings",
    "action_parameters": {
      "cache": false
    }
  },
  "http_response_headers_transform": {
    "ref": "suhail_public_search_response_headers",
    "description": "Search-only no-store/noindex, including Cloudflare error responses",
    "enabled": false,
    "expression": "lower(url_decode(http.request.uri.path, \"r\")) in {\"/search\" \"/search/\" \"/en/search\" \"/en/search/\" \"/ar/search\" \"/ar/search/\"}",
    "action": "rewrite",
    "action_parameters": {
      "headers": {
        "cache-control": { "operation": "set", "value": "private, no-store, max-age=0" },
        "cdn-cache-control": { "operation": "set", "value": "no-store" },
        "cloudflare-cdn-cache-control": { "operation": "set", "value": "no-store" },
        "x-robots-tag": { "operation": "set", "value": "noindex, follow" }
      }
    }
  }
}
