{
  "name": "suhail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "ar-review:list": "tsx scripts/ar-review.ts",
    "admin:grant": "tsx scripts/admin/grant.ts",
    "setup:launch": "node scripts/run-launch.mjs",
    "sec:fsn:dry-run": "node --conditions=react-server --import tsx scripts/sec/fsn-dry-run.ts",
    "smoke": "node scripts/smoke.mjs",
    "admin:reset-mfa": "tsx scripts/admin/reset-mfa.ts",
    "brand:icons": "tsx scripts/brand-icons.ts",
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "build:jobs": "node scripts/build-jobs.mjs",
    "job:ingest": "pnpm build:jobs && node dist/jobs/ingest-all.js",
    "job:screen": "pnpm build:jobs && node dist/jobs/screen-universe.js",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:logical": "node scripts/lint-logical.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:engine": "vitest run --config vitest.engine.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:accounts": "playwright test --config playwright.accounts.config.ts",
    "test:e2e:stock": "playwright test --config playwright.stock.config.ts",
    "test:e2e:hydration": "playwright test --config playwright.hydration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:seed:demo": "tsx --conditions=react-server scripts/db/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "db:test:up": "tsx scripts/db/test-up.ts",
    "test:db": "vitest run --config vitest.database.config.ts",
    "bench:search": "vitest run --config vitest.search-benchmark.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.1",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.1",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
