# db
# Optional for the app; required for workspace/CI migrations only.
DATABASE_URL_MIGRATIONS=
# Required: RLS-limited public Session pooler 5432, suhail_public.<PROJECT_REF> (D-139).
DATABASE_URL_PUBLIC=
# Required: app/jobs Session pooler 5432, suhail_app.<PROJECT_REF> (D-139).
DATABASE_URL_APP=
# Test-only: disposable plain PostgreSQL 17 on loopback, NEVER Supabase (D-78).
# Remove/unset this entry to use db:test:up's local default; see the database handoff.
DATABASE_URL_TEST=
# Required for every non-test database connection: Supabase CA certificate PEM (non-secret).
SUPABASE_DB_CA_CERT=

# auth
# Required: Supabase authentication project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Required: browser-safe Supabase anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Workspace shell CLI only; NEVER configure in application/deployment environments (D-48).
SUPABASE_SECRET_KEY=

# sec
# Required: SEC EDGAR identifying user agent and contact address.
SEC_USER_AGENT=

# storage
# Future storage consumer only (currently unused): S3-compatible API endpoint.
S3_ENDPOINT=
# Future storage consumer only: S3 region.
S3_REGION=
# Future storage consumer only: S3 access key ID.
S3_ACCESS_KEY_ID=
# Future storage consumer only: S3 secret access key.
S3_SECRET_ACCESS_KEY=
# Future storage consumer only: public media bucket.
S3_BUCKET_PUBLIC=
# Future storage consumer only: public media base URL.
PUBLIC_MEDIA_BASE_URL=

# site
# Required: canonical site URL.
SITE_URL=
# Set preview: public but unindexed; live requires separate founder approval (D-137/D-139).
SITE_MODE=
# Optional: temporary forwarding count/classification logs; off unless 1.
FORWARDED_DIAGNOSTICS=

# jobs
# Optional: positive integer batch size; defaults to 100.
JOB_BATCH_SIZE=

# Later (D-54)
# Deferred: Anthropic API credential.
# ANTHROPIC_API_KEY=
# Deferred: explanation model ID.
# LLM_MODEL=
# Deferred: internal revalidation HMAC credential.
# REVALIDATE_SECRET=
# Deferred: archive bucket.
# S3_BUCKET_ARCHIVE=
# Deferred: OTP hook signing credential.
# SEND_OTP_HOOK_SECRET=
